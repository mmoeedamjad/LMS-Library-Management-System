<%- include("../partials/code-header") %>

<%
function getBookCover(book) {
  const title = (book.title || '').toLowerCase();
  const cat = (book.categoryId && book.categoryId.name ? book.categoryId.name : '').toLowerCase();

  if (title.includes('clean code')) return 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=600&q=80';
  if (title.includes('pragmatic')) return 'https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&fit=crop&w=600&q=80';
  if (title.includes('data-intensive')) return 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=600&q=80';
  if (title.includes('1984')) return 'https://images.unsplash.com/photo-1497633762265-9d179a990aa6?auto=format&fit=crop&w=600&q=80';
  if (title.includes('gatsby')) return 'https://images.unsplash.com/photo-1543002588-bfa74002ed7e?auto=format&fit=crop&w=600&q=80';
  if (title.includes('mockingbird')) return 'https://images.unsplash.com/photo-1476275466078-4007374efbbe?auto=format&fit=crop&w=600&q=80';
  if (title.includes('brief history of time')) return 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=600&q=80';
  if (title.includes('cosmos')) return 'https://images.unsplash.com/photo-1446776811953-b23d57bd21aa?auto=format&fit=crop&w=600&q=80';
  if (title.includes('meditations')) return 'https://images.unsplash.com/photo-1568667256549-094345857637?auto=format&fit=crop&w=600&q=80';
  if (title.includes('sapiens')) return 'https://images.unsplash.com/photo-1461360370896-922624d12aa1?auto=format&fit=crop&w=600&q=80';
  if (title.includes('zero to one')) return 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=600&q=80';
  if (title.includes('fast and slow')) return 'https://images.unsplash.com/photo-1434030216411-0b793f4b4173?auto=format&fit=crop&w=600&q=80';

  if (cat.includes('computer')) return 'https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?auto=format&fit=crop&w=600&q=80';
  if (cat.includes('literature')) return 'https://images.unsplash.com/photo-1456513080510-7bf3a84b82f8?auto=format&fit=crop&w=600&q=80';
  if (cat.includes('science') || cat.includes('physics')) return 'https://images.unsplash.com/photo-1507413245164-6160d8298b31?auto=format&fit=crop&w=600&q=80';
  if (cat.includes('philosophy') || cat.includes('history')) return 'https://images.unsplash.com/photo-1461360370896-922624d12aa1?auto=format&fit=crop&w=600&q=80';
  if (cat.includes('business') || cat.includes('economics')) return 'https://images.unsplash.com/photo-1590283603385-17ffb3a7f29f?auto=format&fit=crop&w=600&q=80';

  return 'https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=600&q=80';
}
%>

<!-- Breadcrumb Navigation -->
<div class="admin-topbar d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <div class="d-flex align-items-center gap-2 small">
    <a href="/api/dashboard" class="text-muted text-decoration-none">Dashboard</a>
    <span class="text-muted">/</span>
    <a href="/api/books" class="text-muted text-decoration-none">Books Catalog</a>
    <span class="text-muted">/</span>
    <span class="fw-bold text-dark" style="font-family: var(--font-cinzel);"><%= book.title %></span>
  </div>
  <div class="d-flex gap-2">
    <a href="/api/books/edit/<%= book._id %>" class="btn-terracotta btn-sm d-inline-flex align-items-center gap-1">
      <i class="bi bi-pencil"></i> Edit Volume
    </a>
    <a href="/api/books" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
      <i class="bi bi-arrow-left"></i> Catalog
    </a>
  </div>
</div>

<!-- Header -->
<div class="mb-4">
  <span class="text-uppercase fw-bold" style="font-family: var(--font-cinzel); color: var(--ath-terracotta); font-size: 0.76rem; letter-spacing: 1.5px;">
    VOLUME ACCESSION DOSSIER &bull; DEWEY STACKS
  </span>
  <h1 class="display-6 fw-bold mt-1 mb-1" style="font-family: var(--font-serif); color: var(--ath-text-main);">
    <%= book.title %>
  </h1>
  <p class="text-muted small mb-0">
    Cataloged by <strong><%= book.authorName || 'Author' %></strong> &bull; Registered in Lahore Central Repository.
  </p>
</div>

<div class="row g-4">
  <!-- Left Side: Cover & Accession Meta -->
  <div class="col-lg-4">
    <div class="dashboard-card text-center p-4">
      <img
        src="<%= getBookCover(book) %>"
        alt="<%= book.title %>"
        class="img-fluid rounded border shadow-sm mb-3"
        style="max-height: 280px; width: 100%; object-fit: cover;"
      />

      <div class="mb-3">
        <span class="badge bg-light text-muted border font-monospace small d-inline-block px-3 py-1">
          ID: <%= book._id %>
        </span>
      </div>

      <div class="mb-3">
        <% if (book.copiesAvailable > 0) { %>
          <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 fs-6">
            <i class="bi bi-check-circle me-1"></i> <%= book.copiesAvailable %> Copies on Shelf
          </span>
        <% } else { %>
          <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2 fs-6">
            <i class="bi bi-x-circle me-1"></i> Currently Loaned Out
          </span>
        <% } %>
      </div>

      <div class="d-grid gap-2 pt-2 border-top">
        <a href="/api/books/edit/<%= book._id %>" class="btn-terracotta btn-sm justify-content-center">
          <i class="bi bi-pencil me-1"></i> Edit Volume Details
        </a>
        <button
          type="button"
          class="btn btn-outline-danger btn-sm"
          onclick="confirmDelete('/api/books/delete/<%= book._id %>')"
        >
          <i class="bi bi-trash me-1"></i> Delete from Catalog
        </button>
      </div>
    </div>
  </div>

  <!-- Right Side: Detailed Bibliographic Record -->
  <div class="col-lg-8">
    <div class="dashboard-card mb-4">
      <div class="dashboard-card-header">
        <h3 class="dashboard-card-title" style="font-size: 1.15rem;">
          <i class="bi bi-journal-text text-warning"></i> Accession Details
        </h3>
        <span class="badge bg-light text-dark border font-monospace small">Lahore Central Archive</span>
      </div>

      <div class="dashboard-card-body">
        <div class="table-responsive">
          <table class="table table-borderless align-middle mb-0">
            <tbody>
              <tr class="border-bottom">
                <th style="width: 220px;" class="text-muted small text-uppercase font-monospace">Volume Title</th>
                <td class="fw-bold text-dark fs-5" style="font-family: var(--font-serif);"><%= book.title %></td>
              </tr>
              <tr class="border-bottom">
                <th class="text-muted small text-uppercase font-monospace">Primary Author</th>
                <td class="text-dark"><%= book.authorName %></td>
              </tr>
              <tr class="border-bottom">
                <th class="text-muted small text-uppercase font-monospace">Category Classification</th>
                <td>
                  <span class="badge bg-light text-dark border font-monospace">
                    <%= book.categoryId ? book.categoryId.name : 'Uncategorized' %>
                  </span>
                </td>
              </tr>
              <tr class="border-bottom">
                <th class="text-muted small text-uppercase font-monospace">ISBN Identification</th>
                <td class="font-monospace text-dark"><%= book.isbn || 'N/A' %></td>
              </tr>
              <tr class="border-bottom">
                <th class="text-muted small text-uppercase font-monospace">Physical Shelf Coordinates</th>
                <td>
                  <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25 font-monospace">
                    <i class="bi bi-geo-alt me-1 text-warning"></i> <%= book.shelfLocation || 'STACK-A1' %>
                  </span>
                </td>
              </tr>
              <tr class="border-bottom">
                <th class="text-muted small text-uppercase font-monospace">Total Copies Acquired</th>
                <td class="font-monospace text-dark"><%= book.totalCopies || book.quantity || 0 %></td>
              </tr>
              <tr class="border-bottom">
                <th class="text-muted small text-uppercase font-monospace">Available for Checkout</th>
                <td class="font-monospace text-success fw-bold"><%= book.copiesAvailable %></td>
              </tr>
              <tr>
                <th class="text-muted small text-uppercase font-monospace">Volumes Currently on Loan</th>
                <td class="font-monospace text-muted">
                  <%= Math.max(0, (book.totalCopies || book.quantity || 0) - (book.copiesAvailable || 0)) %>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Circulation Policy Notice -->
    <div class="p-3 bg-light rounded border small text-muted">
      <i class="bi bi-info-circle text-warning me-1"></i>
      <strong>Circulation Guideline:</strong> Physical checkouts are governed under standard 14-day lending windows. Members with overdue notices must discharge outstanding returns before requesting new loans from this stack.
    </div>
  </div>
</div>

<%- include("../partials/code-footer") %>
