<%- include("../partials/code-header") %>

<!-- Breadcrumb Navigation -->
<div class="admin-topbar d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <div class="d-flex align-items-center gap-2 small">
    <a href="/api/dashboard" class="text-muted text-decoration-none">Dashboard</a>
    <span class="text-muted">/</span>
    <span class="fw-bold text-dark" style="font-family: var(--font-cinzel);"><%= pageTitle %></span>
  </div>
  <a href="/api/users/add" class="btn-terracotta btn-sm d-inline-flex align-items-center gap-1">
    <i class="bi bi-person-plus"></i> Enroll <%= role === "admin" ? "Admin" : "Scholar" %>
  </a>
</div>

<!-- Header -->
<div class="mb-4">
  <span class="text-uppercase fw-bold" style="font-family: var(--font-cinzel); color: var(--ath-terracotta); font-size: 0.76rem; letter-spacing: 1.5px;">
    SCHOLAR MEMBERSHIP &bull; IDENTITY ROSTER
  </span>
  <h1 class="display-6 fw-bold mt-1 mb-1" style="font-family: var(--font-serif); color: var(--ath-text-main);">
    <%= pageTitle %>
  </h1>
  <p class="text-muted small mb-0">
    Manage registered patron profiles, system administrators, active access status, and circulation privileges.
  </p>
</div>

<!-- Users Table Card -->
<div class="dashboard-card">
  <div class="dashboard-card-header d-flex flex-wrap align-items-center justify-content-between gap-3">
    <h3 class="dashboard-card-title" style="font-size: 1.15rem;">
      <i class="bi bi-people text-warning"></i> Enrolled Identity Registry
    </h3>
    <div class="d-flex align-items-center gap-2">
      <span class="badge bg-light text-muted border font-monospace small"><%= userList.length %> Enrolled</span>
      <input
        type="text"
        id="userSearchInput"
        class="form-control form-control-sm"
        placeholder="Filter by name or email..."
        style="width: 240px; font-size: 0.82rem;"
        onkeyup="filterUsersTable()"
      />
    </div>
  </div>

  <div class="table-responsive">
    <table class="dashboard-table" id="usersRegistryTable">
      <thead>
        <tr>
          <th style="width: 50px;">#</th>
          <th>Scholar / Staff</th>
          <th>Email Address</th>
          <th>Role</th>
          <th>Enrolled Date</th>
          <th>Account Status</th>
          <th style="width: 140px; text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% userList.forEach((user, index) => { %>
          <tr>
            <td class="font-monospace text-muted small"><%= index + 1 %></td>
            <td>
              <div class="d-flex align-items-center gap-2">
                <div class="p-2 rounded-circle bg-light border text-warning">
                  <i class="bi <%= user.role === 'admin' ? 'bi-shield-lock' : 'bi-person' %>"></i>
                </div>
                <div>
                  <strong class="d-block text-dark" style="font-family: var(--font-serif); font-size: 1.05rem;">
                    <%= user.name %>
                  </strong>
                  <small class="font-monospace text-muted" style="font-size: 0.72rem;">ID: <%= user._id.toString().substring(18) %></small>
                </div>
              </div>
            </td>
            <td class="font-monospace small text-muted">
              <%= user.email %>
            </td>
            <td>
              <span class="badge <%= user.role === 'admin' ? 'bg-secondary' : 'bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25' %> font-monospace small">
                <%= user.role === 'admin' ? 'Administrator' : 'Scholar Member' %>
              </span>
            </td>
            <td class="font-monospace small text-muted">
              <%= user.createdAt.toISOString().split('T')[0] %>
            </td>
            <td>
              <% if (user.isActive === 'Y') { %>
                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 font-monospace small">
                  <i class="bi bi-check-circle me-1"></i> Active
                </span>
              <% } else { %>
                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 font-monospace small">
                  <i class="bi bi-x-circle me-1"></i> Suspended
                </span>
              <% } %>
            </td>
            <td style="text-align: right;">
              <div class="btn-group btn-group-sm">
                <a href="/api/users/<%= user._id %>" class="btn btn-outline-dark py-1 px-2" title="View Dossier">
                  <i class="bi bi-eye"></i>
                </a>
                <a href="/api/users/edit/<%= user._id %>" class="btn btn-outline-secondary py-1 px-2" title="Edit Profile">
                  <i class="bi bi-pencil"></i>
                </a>
                <button
                  type="button"
                  class="btn btn-outline-danger py-1 px-2"
                  title="Delete User"
                  onclick="confirmDelete('/api/users/delete/<%= user._id %>')"
                >
                  <i class="bi bi-trash"></i>
                </button>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- Search filter script -->
<script>
  function filterUsersTable() {
    const q = document.getElementById('userSearchInput').value.toLowerCase();
    const rows = document.querySelectorAll('#usersRegistryTable tbody tr');
    rows.forEach(r => {
      const text = r.textContent.toLowerCase();
      r.style.display = text.includes(q) ? '' : 'none';
    });
  }
</script>

<%- include("../partials/code-footer") %>
