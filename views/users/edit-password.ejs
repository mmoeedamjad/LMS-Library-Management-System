<%- include("../partials/code-header") %>

<!-- Breadcrumb Navigation -->
<div class="admin-topbar d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <div class="d-flex align-items-center gap-2 small">
    <a href="/api/dashboard" class="text-muted text-decoration-none">Dashboard</a>
    <span class="text-muted">/</span>
    <a href="/api/users/personal/<%= user._id %>" class="text-muted text-decoration-none">Personal Profile</a>
    <span class="text-muted">/</span>
    <span class="fw-bold text-dark" style="font-family: var(--font-cinzel);">Change Password</span>
  </div>
  <a href="/api/users/personal/<%= user._id %>" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
    <i class="bi bi-arrow-left"></i> Cancel &amp; Return
  </a>
</div>

<!-- Header -->
<div class="mb-4">
  <span class="text-uppercase fw-bold" style="font-family: var(--font-cinzel); color: var(--ath-terracotta); font-size: 0.76rem; letter-spacing: 1.5px;">
    ADMIN SECURITY PREFERENCES
  </span>
  <h1 class="display-6 fw-bold mt-1 mb-1" style="font-family: var(--font-serif); color: var(--ath-text-main);">
    Update Admin Password
  </h1>
  <p class="text-muted small mb-0">
    Modify your administrative access key for operator account <strong><%= user.name %></strong>.
  </p>
</div>

<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-6">
    <div class="dashboard-card">
      <div class="dashboard-card-header">
        <h3 class="dashboard-card-title" style="font-size: 1.15rem;">
          <i class="bi bi-shield-lock text-warning"></i> Access Key Modification
        </h3>
        <span class="badge bg-light text-muted border font-monospace small">Operator: <%= user.email %></span>
      </div>

      <div class="dashboard-card-body p-4">
        <!-- Error Alerts -->
        <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
          <div class="alert alert-danger py-2 px-3 small border-0 bg-danger bg-opacity-10 text-danger border border-danger border-opacity-20 rounded-2 mb-4">
            <ul class="mb-0 ps-3">
              <% errors.forEach(error => { %>
                <li><%= error.msg %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <form class="styled-form" action="/api/users/pw/<%= user._id %>" method="POST">
          <div class="mb-3">
            <label for="curr-password" class="auth-label">
              <i class="bi bi-lock me-1"></i> Current Password
            </label>
            <input
              type="password"
              name="curr-password"
              id="curr-password"
              class="auth-input"
              placeholder="Enter existing password"
              required
            />
          </div>

          <div class="mb-3">
            <label for="new-password" class="auth-label">
              <i class="bi bi-key me-1"></i> New Password
            </label>
            <input
              type="password"
              name="new-password"
              id="new-password"
              class="auth-input"
              placeholder="At least 6 characters"
              required
            />
          </div>

          <div class="mb-4">
            <label for="conf-password" class="auth-label">
              <i class="bi bi-shield-check me-1"></i> Confirm New Password
            </label>
            <input
              type="password"
              name="conf-password"
              id="conf-password"
              class="auth-input"
              placeholder="Repeat new password"
              required
            />
          </div>

          <div class="d-flex flex-wrap gap-2 pt-3 border-top">
            <button type="submit" class="btn-terracotta d-inline-flex align-items-center gap-1">
              <i class="bi bi-check-circle me-1"></i> Save Updated Password
            </button>
            <a href="/api/users/personal/<%= user._id %>" class="btn btn-outline-secondary">
              Cancel &amp; Return
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include("../partials/code-footer") %>
