<%- include("../partials/code-header") %>

<!-- Breadcrumb Navigation -->
<div class="admin-topbar d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <div class="d-flex align-items-center gap-2 small">
    <a href="/api/dashboard" class="text-muted text-decoration-none">Dashboard</a>
    <span class="text-muted">/</span>
    <span class="fw-bold text-dark" style="font-family: var(--font-cinzel);">Personal Profile</span>
  </div>
  <a href="/api/dashboard" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
    <i class="bi bi-arrow-left"></i> Back to Dashboard
  </a>
</div>

<!-- Header -->
<div class="mb-4">
  <span class="text-uppercase fw-bold" style="font-family: var(--font-cinzel); color: var(--ath-terracotta); font-size: 0.76rem; letter-spacing: 1.5px;">
    STAFF CREDENTIALS &bull; ADMINISTRATIVE OPERATOR
  </span>
  <h1 class="display-6 fw-bold mt-1 mb-1" style="font-family: var(--font-serif); color: var(--ath-text-main);">
    <%= user.name %>
  </h1>
  <p class="text-muted small mb-0">
    System operator profile and security access parameters.
  </p>
</div>

<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-7">
    <% if (typeof success !== 'undefined' && success.length > 0) { %>
      <div class="alert alert-success py-2 px-3 small border-0 bg-success bg-opacity-10 text-success border border-success border-opacity-20 rounded-2 mb-4">
        <i class="bi bi-check-circle me-1"></i> <%= success %>
      </div>
    <% } %>

    <div class="dashboard-card">
      <div class="dashboard-card-header d-flex align-items-center justify-content-between">
        <h3 class="dashboard-card-title" style="font-size: 1.15rem;">
          <i class="bi bi-person-badge text-warning"></i> Operator Profile
        </h3>
        <span class="badge bg-light text-muted border font-monospace small">ID: <%= user._id %></span>
      </div>

      <div class="dashboard-card-body p-4">
        <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
          <div class="p-3 rounded-circle bg-light border text-warning">
            <i class="bi bi-shield-lock-fill fs-2"></i>
          </div>
          <div>
            <h4 class="fw-bold mb-0 text-dark" style="font-family: var(--font-serif);"><%= user.name %></h4>
            <div class="font-monospace small text-muted"><%= user.email %></div>
            <span class="badge bg-secondary font-monospace mt-1">
              Authorized <%= user.role === 'admin' ? 'Administrator' : 'Staff' %>
            </span>
          </div>
        </div>

        <div class="table-responsive mb-4">
          <table class="table table-borderless align-middle mb-0">
            <tbody>
              <tr class="border-bottom">
                <th style="width: 180px;" class="text-muted small text-uppercase font-monospace">Operator Name</th>
                <td class="fw-bold text-dark" style="font-family: var(--font-serif);"><%= user.name %></td>
              </tr>
              <tr class="border-bottom">
                <th class="text-muted small text-uppercase font-monospace">Contact Email</th>
                <td class="font-monospace text-dark"><%= user.email %></td>
              </tr>
              <tr class="border-bottom">
                <th class="text-muted small text-uppercase font-monospace">Credential Issued</th>
                <td class="font-monospace text-dark"><%= user.createdAt.toISOString().split('T')[0] %></td>
              </tr>
              <tr>
                <th class="text-muted small text-uppercase font-monospace">Privilege Level</th>
                <td class="font-monospace text-dark text-capitalize"><%= user.role %> (Full Stacks Custody)</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="d-flex flex-wrap gap-2 pt-3 border-top">
          <a href="/api/users/pw/<%= user._id %>" class="btn-terracotta d-inline-flex align-items-center gap-1">
            <i class="bi bi-key"></i> Update Security Password
          </a>
          <a href="/api/dashboard" class="btn btn-outline-secondary">
            Return to Dashboard
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include("../partials/code-footer") %>
