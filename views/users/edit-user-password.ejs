<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Update Security Password | Library Management System</title>
    <!-- Google Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400;1,600&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Courier+Prime:wght@400;700&display=swap" rel="stylesheet" />
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body style="background-color: var(--ath-bg-light); min-height: 100vh; display: flex; flex-direction: column;">
    <!-- Top Utility Bar -->
    <div class="ath-topbar">
      <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center gap-3">
          <span><i class="bi bi-geo-alt me-1 text-warning"></i> Shahrah-e-Quaid-e-Azam, Lahore, Pakistan</span>
          <span class="d-none d-md-inline">&bull;</span>
          <span class="d-none d-md-inline"><i class="bi bi-telephone me-1 text-warning"></i> +92 (042) 9921-4501</span>
        </div>
        <div>
          <span><i class="bi bi-shield-lock me-1 text-warning"></i> Account Security Setting</span>
        </div>
      </div>
    </div>

    <!-- Main Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-athenaeum sticky-top">
      <div class="container">
        <a class="brand-athenaeum" href="/api/user-dashboard">
          <div class="brand-seal">
            <i class="bi bi-book-half"></i>
          </div>
          <div>
            <div class="brand-title">ATHENAEUM</div>
            <div class="brand-subtitle">Scholar Security Console</div>
          </div>
        </a>

        <div class="d-flex align-items-center gap-3">
          <div class="dashboard-user-badge">
            <i class="bi bi-person-circle text-warning fs-5"></i>
            <div>
              <div class="fw-bold text-dark lh-1 small"><%= user.name %></div>
              <span class="badge bg-light text-muted border p-0 px-1 font-monospace" style="font-size: 0.65rem;"><%= user.role %></span>
            </div>
          </div>

          <a class="btn btn-sm btn-outline-dark px-3 d-inline-flex align-items-center gap-1" href="/api/user-dashboard">
            <i class="bi bi-arrow-left"></i> Dashboard
          </a>
        </div>
      </div>
    </nav>

    <!-- Main Form Container -->
    <main class="container py-5 flex-grow-1 d-flex align-items-center justify-content-center">
      <div class="row justify-content-center w-100">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5">
          <div class="dashboard-card mb-0 shadow-sm">
            <div class="dashboard-card-header text-center d-block py-3">
              <span class="text-uppercase fw-bold" style="font-family: var(--font-cinzel); color: var(--ath-terracotta); font-size: 0.72rem; letter-spacing: 1.2px;">
                <i class="bi bi-shield-check me-1"></i> SECURITY PREFERENCES
              </span>
              <h2 class="h4 fw-bold mt-1 mb-0" style="font-family: var(--font-serif); color: var(--ath-text-main);">
                Update Access Password
              </h2>
            </div>

            <div class="dashboard-card-body p-4">
              <!-- Error Alert -->
              <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
                <div class="alert alert-danger py-2 px-3 small border-0 bg-danger bg-opacity-10 text-danger border border-danger border-opacity-20 rounded-2 mb-3">
                  <ul class="mb-0 ps-3">
                    <% errors.forEach(error => { %>
                      <li><%= error.msg %></li>
                    <% }) %>
                  </ul>
                </div>
              <% } %>

              <!-- User Identifier Summary -->
              <div class="p-3 bg-light rounded border mb-4 d-flex align-items-center gap-3">
                <div class="p-2 rounded-circle bg-white border text-warning">
                  <i class="bi bi-person-badge fs-4"></i>
                </div>
                <div>
                  <div class="fw-bold text-dark"><%= user.name %></div>
                  <div class="small text-muted"><%= user.email %></div>
                </div>
              </div>

              <!-- Password Form -->
              <form action="/api/users/pw/<%= user._id %>" method="POST" class="styled-form">
                <div class="mb-3">
                  <label for="curr-password" class="auth-label">
                    <i class="bi bi-lock me-1"></i> Current Password
                  </label>
                  <div class="position-relative">
                    <input
                      type="password"
                      class="auth-input pe-5"
                      id="curr-password"
                      name="curr-password"
                      placeholder="Enter existing password"
                      required
                      autocomplete="current-password"
                    />
                    <button
                      type="button"
                      class="btn btn-link text-muted position-absolute top-50 end-0 translate-middle-y me-2 p-0 text-decoration-none"
                      onclick="togglePasswordVisibility('curr-password', this)"
                      title="Toggle password display"
                    >
                      <i class="bi bi-eye"></i>
                    </button>
                  </div>
                </div>

                <div class="mb-3">
                  <label for="new-password" class="auth-label">
                    <i class="bi bi-key me-1"></i> New Password
                  </label>
                  <div class="position-relative">
                    <input
                      type="password"
                      class="auth-input pe-5"
                      id="new-password"
                      name="new-password"
                      placeholder="At least 6 characters"
                      required
                      autocomplete="new-password"
                    />
                    <button
                      type="button"
                      class="btn btn-link text-muted position-absolute top-50 end-0 translate-middle-y me-2 p-0 text-decoration-none"
                      onclick="togglePasswordVisibility('new-password', this)"
                      title="Toggle password display"
                    >
                      <i class="bi bi-eye"></i>
                    </button>
                  </div>
                </div>

                <div class="mb-4">
                  <label for="conf-password" class="auth-label">
                    <i class="bi bi-shield-check me-1"></i> Confirm New Password
                  </label>
                  <div class="position-relative">
                    <input
                      type="password"
                      class="auth-input pe-5"
                      id="conf-password"
                      name="conf-password"
                      placeholder="Repeat new password"
                      required
                      autocomplete="new-password"
                    />
                    <button
                      type="button"
                      class="btn btn-link text-muted position-absolute top-50 end-0 translate-middle-y me-2 p-0 text-decoration-none"
                      onclick="togglePasswordVisibility('conf-password', this)"
                      title="Toggle password display"
                    >
                      <i class="bi bi-eye"></i>
                    </button>
                  </div>
                </div>

                <div class="d-grid gap-2">
                  <button type="submit" class="btn-terracotta justify-content-center py-2">
                    <i class="bi bi-check-circle me-1"></i> Save Updated Password
                  </button>
                  <a href="/api/user-dashboard" class="btn btn-outline-secondary py-2 small">
                    <i class="bi bi-arrow-left me-1"></i> Cancel &amp; Return to Dashboard
                  </a>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer class="footer-athenaeum py-3 mt-auto">
      <div class="container text-center small text-white-50">
        &copy; 2026 Library Management System &bull; Open-Source Scholar Portal &bull; <a href="/api/user-dashboard" class="text-white-50">Back to Dashboard</a>
      </div>
    </footer>

    <!-- Password visibility toggle script -->
    <script>
      function togglePasswordVisibility(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector('i');
        if (input.type === 'password') {
          input.type = 'text';
          icon.classList.replace('bi-eye', 'bi-eye-slash');
        } else {
          input.type = 'password';
          icon.classList.replace('bi-eye-slash', 'bi-eye');
        }
      }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
