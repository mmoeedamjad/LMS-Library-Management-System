<%- include("../partials/code-header") %>

<!-- Breadcrumb Navigation -->
<div class="admin-topbar d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <div class="d-flex align-items-center gap-2 small">
    <a href="/api/dashboard" class="text-muted text-decoration-none">Dashboard</a>
    <span class="text-muted">/</span>
    <a href="/api/users/<%= role %>" class="text-muted text-decoration-none"><%= role === 'admin' ? 'Admins' : 'Users' %></a>
    <span class="text-muted">/</span>
    <span class="fw-bold text-dark" style="font-family: var(--font-cinzel);">New Account</span>
  </div>
  <a href="/api/users/<%= role %>" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
    <i class="bi bi-arrow-left"></i> Back to <%= role === 'admin' ? 'Admins' : 'Users' %>
  </a>
</div>

<!-- Header -->
<div class="mb-4">
  <span class="text-uppercase fw-bold" style="font-family: var(--font-cinzel); color: var(--ath-terracotta); font-size: 0.76rem; letter-spacing: 1.5px;">
    MEMBERSHIP ONBOARDING &bull; IDENTITY REGISTRATION
  </span>
  <h1 class="display-6 fw-bold mt-1 mb-1" style="font-family: var(--font-serif); color: var(--ath-text-main);">
    Enroll New <%= role === "admin" ? "Administrator" : "Scholar Member" %>
  </h1>
  <p class="text-muted small mb-0">
    Register patron identity, assign administrative or borrowing privileges, and initialize account access.
  </p>
</div>

<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-7">
    <div class="dashboard-card">
      <div class="dashboard-card-header">
        <h3 class="dashboard-card-title" style="font-size: 1.15rem;">
          <i class="bi bi-person-plus text-warning"></i> Account Credentials
        </h3>
        <span class="badge bg-light text-muted border font-monospace small">Initial Password: 123456</span>
      </div>

      <div class="dashboard-card-body p-4">
        <!-- Error Alerts -->
        <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
          <div class="alert alert-danger py-2 px-3 small border-0 bg-danger bg-opacity-10 text-danger border border-danger border-opacity-20 rounded-2 mb-4">
            <ul class="mb-0 ps-3">
              <% errors.forEach(error => { %>
                <li><%= error.msg %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <form class="styled-form" action="/api/users" method="POST">
          <div class="mb-3">
            <label for="name" class="auth-label">
              <i class="bi bi-person me-1"></i> Full Name
            </label>
            <input
              type="text"
              name="name"
              id="name"
              class="auth-input"
              placeholder="e.g. Dr. Tariq Rehman / Ayesha Khan"
              value="<%= oldInput?.name || '' %>"
              required
            />
          </div>

          <div class="mb-3">
            <label for="email" class="auth-label">
              <i class="bi bi-envelope me-1"></i> Email Address
            </label>
            <input
              type="email"
              name="email"
              id="email"
              class="auth-input"
              placeholder="scholar@university.edu.pk"
              value="<%= oldInput?.email || '' %>"
              required
            />
          </div>

          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label for="role" class="auth-label">
                <i class="bi bi-shield me-1"></i> Account Role
              </label>
              <select name="role" id="role" class="auth-input">
                <option value="user" <%= (oldInput?.role || role) === "user" ? 'selected' : '' %>>Scholar Member (user)</option>
                <option value="admin" <%= (oldInput?.role || role) === "admin" ? 'selected' : '' %>>System Administrator (admin)</option>
              </select>
            </div>

            <div class="col-md-6">
              <label for="isActive" class="auth-label">
                <i class="bi bi-toggle-on me-1"></i> Active Status
              </label>
              <select name="isActive" id="isActive" class="auth-input">
                <option value="Y" <%= oldInput?.isActive !== "N" ? 'selected' : '' %>>Active (Y)</option>
                <option value="N" <%= oldInput?.isActive === "N" ? 'selected' : '' %>>Suspended (N)</option>
              </select>
            </div>
          </div>

          <input type="hidden" name="password" value="123456" />

          <div class="p-3 bg-light rounded border small text-muted mb-4">
            <i class="bi bi-info-circle text-warning me-1"></i>
            <strong>Default Credential:</strong> Newly registered accounts are seeded with initial password <code>123456</code>. Users can update this anytime via their security console.
          </div>

          <div class="d-flex flex-wrap gap-2 pt-3 border-top">
            <button type="submit" class="btn-terracotta d-inline-flex align-items-center gap-1">
              <i class="bi bi-check-circle me-1"></i> Enroll Account
            </button>
            <a href="/api/users/<%= role %>" class="btn btn-outline-secondary">
              Cancel &amp; Return
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include("../partials/code-footer") %>