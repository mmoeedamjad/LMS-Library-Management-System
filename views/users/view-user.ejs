<%- include("../partials/code-header") %>

<!-- Breadcrumb Navigation -->
<div class="admin-topbar d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <div class="d-flex align-items-center gap-2 small">
    <a href="/api/dashboard" class="text-muted text-decoration-none">Dashboard</a>
    <span class="text-muted">/</span>
    <a href="/api/users/<%= user.role %>" class="text-muted text-decoration-none"><%= user.role === 'admin' ? 'Admins' : 'Users' %></a>
    <span class="text-muted">/</span>
    <span class="fw-bold text-dark" style="font-family: var(--font-cinzel);"><%= user.name %></span>
  </div>
  <div class="d-flex gap-2">
    <a href="/api/users/edit/<%= user._id %>" class="btn-terracotta btn-sm d-inline-flex align-items-center gap-1">
      <i class="bi bi-pencil"></i> Edit Account
    </a>
    <a href="/api/users/<%= user.role %>" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
      <i class="bi bi-arrow-left"></i> <%= user.role === 'admin' ? 'Admins' : 'Users' %>
    </a>
  </div>
</div>

<!-- Header -->
<div class="mb-4">
  <span class="text-uppercase fw-bold" style="font-family: var(--font-cinzel); color: var(--ath-terracotta); font-size: 0.76rem; letter-spacing: 1.5px;">
    ACCOUNT DOSSIER &bull; IDENTITY RECORD
  </span>
  <h1 class="display-6 fw-bold mt-1 mb-1" style="font-family: var(--font-serif); color: var(--ath-text-main);">
    <%= user.name %>
  </h1>
  <p class="text-muted small mb-0">
    <%= user.role === 'admin' ? 'Authorized System Administrator' : 'Enrolled Scholar Patron' %> &bull; Lahore Central Repository.
  </p>
</div>

<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-7">
    <div class="dashboard-card">
      <div class="dashboard-card-header d-flex align-items-center justify-content-between">
        <h3 class="dashboard-card-title" style="font-size: 1.15rem;">
          <i class="bi bi-person-vcard text-warning"></i> Member Profile Details
        </h3>
        <span class="badge bg-light text-muted border font-monospace small">ID: <%= user._id %></span>
      </div>

      <div class="dashboard-card-body p-4">
        <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
          <div class="p-3 rounded-circle bg-light border text-warning">
            <i class="bi <%= user.role === 'admin' ? 'bi-shield-lock' : 'bi-person' %> fs-2"></i>
          </div>
          <div>
            <h4 class="fw-bold mb-0 text-dark" style="font-family: var(--font-serif);"><%= user.name %></h4>
            <div class="font-monospace small text-muted"><%= user.email %></div>
            <span class="badge <%= user.role === 'admin' ? 'bg-secondary' : 'bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25' %> mt-1 font-monospace">
              <%= user.role === 'admin' ? 'Administrator' : 'Scholar Member' %>
            </span>
          </div>
        </div>

        <div class="table-responsive mb-4">
          <table class="table table-borderless align-middle mb-0">
            <tbody>
              <tr class="border-bottom">
                <th style="width: 180px;" class="text-muted small text-uppercase font-monospace">Enrolled Since</th>
                <td class="font-monospace text-dark"><%= user.createdAt.toISOString().split('T')[0] %></td>
              </tr>
              <tr class="border-bottom">
                <th class="text-muted small text-uppercase font-monospace">System Role</th>
                <td class="font-monospace text-dark text-capitalize"><%= user.role %></td>
              </tr>
              <tr class="border-bottom">
                <th class="text-muted small text-uppercase font-monospace">Access Status</th>
                <td>
                  <% if (user.isActive === 'Y') { %>
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 font-monospace">
                      <i class="bi bi-check-circle me-1"></i> Active Privileges
                    </span>
                  <% } else { %>
                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 font-monospace">
                      <i class="bi bi-x-circle me-1"></i> Suspended
                    </span>
                  <% } %>
                </td>
              </tr>
              <tr>
                <th class="text-muted small text-uppercase font-monospace">Borrowing Allowance</th>
                <td class="text-dark">Standard 3 Volumes Physical Quota (14 Days)</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 pt-3 border-top">
          <div class="d-flex gap-2">
            <a href="/api/users/edit/<%= user._id %>" class="btn-terracotta d-inline-flex align-items-center gap-1">
              <i class="bi bi-pencil"></i> Edit Account
            </a>
            <a href="/api/users/<%= user.role %>" class="btn btn-outline-secondary">
              Back to List
            </a>
          </div>
          <button
            type="button"
            class="btn btn-outline-danger d-inline-flex align-items-center gap-1"
            onclick="confirmDelete('/api/users/delete/<%= user._id %>')"
          >
            <i class="bi bi-trash"></i> Delete Account
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include("../partials/code-footer") %>
