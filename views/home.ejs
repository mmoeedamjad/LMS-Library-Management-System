    <!-- Catalog Live Search & Drawer Filtering -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const searchInput = document.getElementById('catalogSearch');
        const clearBtn = document.getElementById('catalogClearBtn');
        const drawerBtns = document.querySelectorAll('.drawer-tab');
        const bookCards = document.querySelectorAll('.book-card-col');
        const noMatch = document.getElementById('noMatchMessage');
        const resetBtn = document.getElementById('resetSearchFilter');
        const heroQuickSearch = document.getElementById('heroQuickSearch');

        let activeCategory = 'all';
        let searchQuery = '';

        function filterCatalog() {
          let visibleCount = 0;
          const query = searchQuery.trim().toLowerCase();

          bookCards.forEach(card => {
            const title = card.dataset.title || '';
            const author = card.dataset.author || '';
            const isbn = card.dataset.isbn || '';
            const shelf = card.dataset.shelf || '';
            const cat = card.dataset.category || '';

            const matchesCategory = (activeCategory === 'all' || cat === activeCategory);
            const matchesQuery = !query || (
              title.includes(query) ||
              author.includes(query) ||
              isbn.includes(query) ||
              shelf.includes(query)
            );

            if (matchesCategory && matchesQuery) {
              card.style.display = '';
              visibleCount++;
            } else {
              card.style.display = 'none';
            }
          });

          if (visibleCount === 0 && bookCards.length > 0) {
            noMatch.classList.remove('d-none');
          } else {
            noMatch.classList.add('d-none');
          }
        }

        searchInput.addEventListener('input', (e) => {
          searchQuery = e.target.value;
          clearBtn.classList.toggle('d-none', searchQuery.length === 0);
          filterCatalog();
        });

        clearBtn.addEventListener('click', () => {
          searchInput.value = '';
          searchQuery = '';
          clearBtn.classList.add('d-none');
          searchInput.focus();
          filterCatalog();
        });

        drawerBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            drawerBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            activeCategory = btn.dataset.category;
            filterCatalog();
          });
        });

        if (resetBtn) {
          resetBtn.addEventListener('click', () => {
            searchInput.value = '';
            searchQuery = '';
            clearBtn.classList.add('d-none');
            activeCategory = 'all';
            drawerBtns.forEach(b => {
              b.classList.toggle('active', b.dataset.category === 'all');
            });
            filterCatalog();
          });
        }

        if (heroQuickSearch) {
          heroQuickSearch.addEventListener('input', (e) => {
            searchQuery = e.target.value;
            searchInput.value = searchQuery;
            clearBtn.classList.toggle('d-none', searchQuery.length === 0);
            filterCatalog();
          });
          heroQuickSearch.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
              e.preventDefault();
              document.getElementById('card-catalog').scrollIntoView({ behavior: 'smooth' });
            }
          });
        }
      });
    </script>
