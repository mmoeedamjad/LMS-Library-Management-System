    <!-- Interactive On-Dashboard Book Details & Hold Script -->
    <script>
      function showBookDetails(data) {
        document.getElementById('modalTitle').textContent = decodeURIComponent(data.title);
        document.getElementById('modalAuthor').textContent = 'by ' + decodeURIComponent(data.author);
        document.getElementById('modalShelf').innerHTML = '<i class="bi bi-geo-alt me-1 text-warning"></i> Shelf: ' + decodeURIComponent(data.shelf);
        document.getElementById('modalIsbn').textContent = 'ISBN: ' + decodeURIComponent(data.isbn);
        document.getElementById('modalCopies').textContent = data.copies + ' Available on Shelf';
        document.getElementById('modalCover').src = data.cover;
        document.getElementById('modalReserveNotice').classList.add('d-none');
        document.getElementById('btnReserve').disabled = false;
        document.getElementById('btnReserve').innerHTML = '<i class="bi bi-bookmark-plus me-1"></i> Request 24h Hold';
        
        const modal = new bootstrap.Modal(document.getElementById('stackBookModal'));
        modal.show();
      }

      function requestHold() {
        const btn = document.getElementById('btnReserve');
        btn.disabled = true;
        btn.innerHTML = '<i class="bi bi-check2"></i> Hold Placed';
        document.getElementById('modalReserveNotice').classList.remove('d-none');
      }
    </script>
    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
