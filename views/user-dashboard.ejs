<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Member Dashboard | Library Management System</title>
    <!-- Google Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body style="background-color: var(--ath-bg-light);">
    <%
    function getBookCover(book) {
      const title = (book.title || '').toLowerCase();
      const cat = (book.categoryId && book.categoryId.name ? book.categoryId.name : '').toLowerCase();

      if (title.includes('clean code')) return 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=600&q=80';
      if (title.includes('pragmatic')) return 'https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&fit=crop&w=600&q=80';
      if (title.includes('data-intensive')) return 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=600&q=80';
      if (title.includes('1984')) return 'https://images.unsplash.com/photo-1497633762265-9d179a990aa6?auto=format&fit=crop&w=600&q=80';
      if (title.includes('gatsby')) return 'https://images.unsplash.com/photo-1543002588-bfa74002ed7e?auto=format&fit=crop&w=600&q=80';
      if (title.includes('mockingbird')) return 'https://images.unsplash.com/photo-1476275466078-4007374efbbe?auto=format&fit=crop&w=600&q=80';
      if (title.includes('brief history of time')) return 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=600&q=80';
      if (title.includes('cosmos')) return 'https://images.unsplash.com/photo-1446776811953-b23d57bd21aa?auto=format&fit=crop&w=600&q=80';
      if (title.includes('meditations')) return 'https://images.unsplash.com/photo-1568667256549-094345857637?auto=format&fit=crop&w=600&q=80';
      if (title.includes('sapiens')) return 'https://images.unsplash.com/photo-1461360370896-922624d12aa1?auto=format&fit=crop&w=600&q=80';
      if (title.includes('zero to one')) return 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=600&q=80';
      if (title.includes('fast and slow')) return 'https://images.unsplash.com/photo-1434030216411-0b793f4b4173?auto=format&fit=crop&w=600&q=80';

      if (cat.includes('computer')) return 'https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?auto=format&fit=crop&w=600&q=80';
      if (cat.includes('literature')) return 'https://images.unsplash.com/photo-1456513080510-7bf3a84b82f8?auto=format&fit=crop&w=600&q=80';
      if (cat.includes('science') || cat.includes('physics')) return 'https://images.unsplash.com/photo-1507413245164-6160d8298b31?auto=format&fit=crop&w=600&q=80';
      if (cat.includes('philosophy') || cat.includes('history')) return 'https://images.unsplash.com/photo-1461360370896-922624d12aa1?auto=format&fit=crop&w=600&q=80';
      if (cat.includes('business') || cat.includes('economics')) return 'https://images.unsplash.com/photo-1590283603385-17ffb3a7f29f?auto=format&fit=crop&w=600&q=80';

      return 'https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=600&q=80';
    }
    %>

    <!-- Top Utility Bar -->
    <div class="ath-topbar">
      <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center gap-3">
          <span><i class="bi bi-geo-alt me-1 text-warning"></i> Shahrah-e-Quaid-e-Azam, Lahore, Pakistan</span>
          <span class="d-none d-md-inline">&bull;</span>
          <span class="d-none d-md-inline"><i class="bi bi-telephone me-1 text-warning"></i> +92 (042) 9921-4501</span>
        </div>
        <div>
          <span><i class="bi bi-shield-check me-1 text-success"></i> Authenticated Member Session</span>
        </div>
      </div>
    </div>

    <!-- Main Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-athenaeum sticky-top">
      <div class="container">
        <a class="brand-athenaeum" href="/api/home">
          <div class="brand-seal">
            <i class="bi bi-book-half"></i>
          </div>
          <div>
            <div class="brand-title">ATHENAEUM</div>
            <div class="brand-subtitle">Member Portal &bull; Lahore Campus</div>
          </div>
        </a>

        <div class="d-flex align-items-center gap-3">
          <a href="/api/home" class="btn btn-sm btn-outline-secondary d-none d-sm-inline-flex align-items-center gap-1">
            <i class="bi bi-compass"></i> Public Catalog
          </a>

          <div class="dashboard-user-badge">
            <i class="bi bi-person-circle text-warning fs-5"></i>
            <div>
              <div class="fw-bold text-dark lh-1 small"><%= user.name %></div>
              <span class="badge bg-light text-muted border p-0 px-1 font-monospace" style="font-size: 0.65rem;"><%= user.role %></span>
            </div>
          </div>

          <a class="btn btn-sm btn-outline-danger px-3 d-inline-flex align-items-center gap-1" href="/api/auth/logout">
            <i class="bi bi-box-arrow-right"></i> Logout
          </a>
        </div>
      </div>
    </nav>

    <!-- Dashboard Hero Header Bar -->
    <div class="dashboard-header-bar">
      <div class="container">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
          <div>
            <span class="text-uppercase fw-bold" style="font-family: var(--font-cinzel); color: var(--ath-terracotta); font-size: 0.78rem; letter-spacing: 1.5px;">
              <i class="bi bi-award me-1"></i> SCHOLAR CIRCULATION DESK
            </span>
            <h1 class="display-6 fw-bold mt-1 mb-0" style="font-family: var(--font-serif); color: var(--ath-text-main);">
              Welcome Back, <%= user.name %>
            </h1>
            <p class="text-muted small mb-0 mt-1">
              Track your active borrowings, review circulation deadlines, and explore available volumes in the repository.
            </p>
          </div>

          <div class="d-flex gap-2">
            <a href="#available-stacks" class="btn-terracotta btn-sm">
              <i class="bi bi-search me-1"></i> Browse Stacks
            </a>
            <a href="/api/users/pw/<%= user._id %>" class="btn-outline-terracotta btn-sm">
              <i class="bi bi-key me-1"></i> Change Password
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Workspace Container -->
    <div class="container py-4">
      <% if (typeof success !== 'undefined') { %>
        <div class="alert alert-success alert-dismissible fade show border-0 bg-success bg-opacity-10 text-success border border-success border-opacity-20 rounded-3 mb-4" role="alert">
          <i class="bi bi-check-circle-fill me-2"></i> <strong>Success:</strong> <%= success %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>

      <!-- Key Metrics Stat Ribbon -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
          <div class="dashboard-stat-card">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <span class="text-muted small text-uppercase fw-bold" style="font-family: var(--font-cinzel); font-size: 0.7rem; letter-spacing: 1px;">
                Active Loans
              </span>
              <div class="p-2 rounded bg-warning bg-opacity-10 text-warning">
                <i class="bi bi-hourglass-split fs-5"></i>
              </div>
            </div>
            <div class="dashboard-stat-number" style="color: var(--ath-terracotta);">
              <%= borrowedBooks.length %>
            </div>
            <div class="text-muted small mt-1">of 3 allowed quota</div>
          </div>
        </div>

        <div class="col-6 col-md-3">
          <div class="dashboard-stat-card">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <span class="text-muted small text-uppercase fw-bold" style="font-family: var(--font-cinzel); font-size: 0.7rem; letter-spacing: 1px;">
                Remaining Quota
              </span>
              <div class="p-2 rounded bg-success bg-opacity-10 text-success">
                <i class="bi bi-bookmark-check fs-5"></i>
              </div>
            </div>
            <div class="dashboard-stat-number" style="color: #2e7d32;">
              <%= Math.max(0, 3 - borrowedBooks.length) %>
            </div>
            <div class="text-muted small mt-1">Volumes available to issue</div>
          </div>
        </div>

        <div class="col-6 col-md-3">
          <div class="dashboard-stat-card">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <span class="text-muted small text-uppercase fw-bold" style="font-family: var(--font-cinzel); font-size: 0.7rem; letter-spacing: 1px;">
                Completed Returns
              </span>
              <div class="p-2 rounded bg-primary bg-opacity-10 text-primary">
                <i class="bi bi-clock-history fs-5"></i>
              </div>
            </div>
            <div class="dashboard-stat-number">
              <%= history.length %>
            </div>
            <div class="text-muted small mt-1">Past returned volumes</div>
          </div>
        </div>

        <div class="col-6 col-md-3">
          <div class="dashboard-stat-card">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <span class="text-muted small text-uppercase fw-bold" style="font-family: var(--font-cinzel); font-size: 0.7rem; letter-spacing: 1px;">
                Ready in Stacks
              </span>
              <div class="p-2 rounded bg-info bg-opacity-10 text-info">
                <i class="bi bi-collection fs-5"></i>
              </div>
            </div>
            <div class="dashboard-stat-number">
              <%= availableBooks.length %>
            </div>
            <div class="text-muted small mt-1">Titles on shelf</div>
          </div>
        </div>
      </div>

      <!-- Member Profile Card & Circulation Quota Overview -->
      <div class="row g-4 mb-4">
        <div class="col-lg-5">
          <div class="dashboard-card h-100 mb-0">
            <div class="dashboard-card-header">
              <h3 class="dashboard-card-title">
                <i class="bi bi-person-vcard text-warning"></i> Member Credentials
              </h3>
              <span class="badge bg-light text-muted border font-monospace small">ID: <%= user._id.toString().substring(18) %></span>
            </div>
            <div class="dashboard-card-body">
              <div class="d-flex align-items-center gap-3 mb-3 pb-3 border-bottom">
                <div class="rounded-circle bg-light p-3 text-warning border">
                  <i class="bi bi-person-fill fs-2"></i>
                </div>
                <div>
                  <h5 class="fw-bold mb-0 text-dark" style="font-family: var(--font-serif);"><%= user.name %></h5>
                  <div class="text-muted small"><%= user.email %></div>
                  <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 mt-1">
                    <i class="bi bi-shield-check me-1"></i> Verified Scholar (<%= user.role %>)
                  </span>
                </div>
              </div>

              <div class="small text-muted mb-3">
                <div class="d-flex justify-content-between py-1 border-bottom">
                  <span>Home Branch:</span>
                  <strong class="text-dark">Central Library, The Mall, Lahore</strong>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom">
                  <span>Borrowing Duration:</span>
                  <strong class="text-dark">14 Calendar Days / Loan</strong>
                </div>
                <div class="d-flex justify-content-between py-1">
                  <span>Online Renewals Allowed:</span>
                  <strong class="text-dark">Up to 2 Times</strong>
                </div>
              </div>

              <a href="/api/users/pw/<%= user._id %>" class="btn btn-outline-dark btn-sm w-100">
                <i class="bi bi-key me-1"></i> Update Security Password
              </a>
            </div>
          </div>
        </div>

        <div class="col-lg-7">
          <div class="dashboard-card h-100 mb-0">
            <div class="dashboard-card-header">
              <h3 class="dashboard-card-title">
                <i class="bi bi-speedometer2 text-warning"></i> Borrowing Quota Status
              </h3>
              <span class="badge <%= borrowedBooks.length >= 3 ? 'bg-danger' : 'bg-success' %>">
                <%= borrowedBooks.length %> / 3 Used
              </span>
            </div>
            <div class="dashboard-card-body d-flex flex-column justify-content-between">
              <div>
                <p class="text-muted small mb-2">
                  You are currently using <strong><%= borrowedBooks.length %></strong> of your <strong>3</strong> volume physical checkout limit.
                </p>
                <div class="progress mb-3" style="height: 12px;">
                  <div
                    class="progress-bar <%= borrowedBooks.length >= 3 ? 'bg-danger' : 'bg-warning' %>"
                    role="progressbar"
                    style="width: <%= (borrowedBooks.length / 3) * 100 %>%;"
                    aria-valuenow="<%= borrowedBooks.length %>"
                    aria-valuemin="0"
                    aria-valuemax="3"
                  ></div>
                </div>

                <div class="row g-2 text-center small text-muted mb-3">
                  <div class="col-4 p-2 bg-light rounded border">
                    <div class="fw-bold text-dark"><%= borrowedBooks.length %></div>
                    <small>On Loan</small>
                  </div>
                  <div class="col-4 p-2 bg-light rounded border">
                    <div class="fw-bold text-dark"><%= Math.max(0, 3 - borrowedBooks.length) %></div>
                    <small>Available</small>
                  </div>
                  <div class="col-4 p-2 bg-light rounded border">
                    <div class="fw-bold text-dark">0</div>
                    <small>Overdue Fines</small>
                  </div>
                </div>
              </div>

              <div class="p-3 bg-light rounded border small text-muted">
                <i class="bi bi-info-circle text-warning me-1"></i>
                <strong>Notice:</strong> To return borrowed books, please deposit them at the Circulation Desk on Mall Road or utilize the automated return box at the North Reading Hall.
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Section: Currently Borrowed Volumes -->
      <div class="dashboard-card" id="my-loans">
        <div class="dashboard-card-header">
          <h3 class="dashboard-card-title">
            <i class="bi bi-book-half text-warning"></i> Currently Borrowed Volumes
          </h3>
          <span class="badge bg-warning text-dark font-monospace"><%= borrowedBooks.length %> Active</span>
        </div>

        <% if (borrowedBooks.length === 0) { %>
          <div class="dashboard-card-body text-center py-5">
            <div class="mb-3 text-muted" style="font-size: 3rem;">
              <i class="bi bi-journal-check text-warning"></i>
            </div>
            <h5 class="fw-bold text-dark" style="font-family: var(--font-serif);">No Active Borrowings</h5>
            <p class="text-muted small max-w-md mx-auto mb-3">
              You currently have no books on loan. Browse our central repository catalog below to request volumes from the physical stacks.
            </p>
            <a href="#available-stacks" class="btn-terracotta btn-sm">
              <i class="bi bi-search me-1"></i> Explore Available Stacks
            </a>
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="dashboard-table">
              <thead>
                <tr>
                  <th>Volume Details</th>
                  <th>Author</th>
                  <th>Borrowed On</th>
                  <th>Due Date</th>
                  <th>Circulation Status</th>
                </tr>
              </thead>
              <tbody>
                <% borrowedBooks.forEach(book => { %>
                  <tr>
                    <td>
                      <strong class="d-block text-dark" style="font-family: var(--font-serif); font-size: 1.1rem;">
                        <%= book.title %>
                      </strong>
                    </td>
                    <td class="text-muted"><%= book.author || 'Cataloged Author' %></td>
                    <td class="font-monospace small text-muted"><%= book.borrowedDate %></td>
                    <td>
                      <span class="font-monospace fw-bold text-danger"><%= book.dueDate %></span>
                    </td>
                    <td>
                      <span class="status-loan">
                        <i class="bi bi-hourglass-split me-1"></i> <%= book.status %>
                      </span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <!-- Section: Borrowing History -->
      <div class="dashboard-card">
        <div class="dashboard-card-header">
          <h3 class="dashboard-card-title">
            <i class="bi bi-clock-history text-warning"></i> Archival Borrowing History
          </h3>
          <span class="badge bg-light text-muted border font-monospace"><%= history.length %> Records</span>
        </div>

        <% if (history.length === 0) { %>
          <div class="dashboard-card-body text-center py-4 text-muted small">
            <i class="bi bi-archive me-1"></i> No past completed returns recorded in your ledger yet.
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="dashboard-table">
              <thead>
                <tr>
                  <th>Volume Title</th>
                  <th>Author</th>
                  <th>Issue Date</th>
                  <th>Returned Date</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% history.forEach(book => { %>
                  <tr>
                    <td>
                      <strong class="d-block text-dark" style="font-family: var(--font-serif);">
                        <%= book.title %>
                      </strong>
                    </td>
                    <td class="text-muted"><%= book.author || 'Author' %></td>
                    <td class="font-monospace small text-muted"><%= book.borrowedDate %></td>
                    <td class="font-monospace small text-success"><%= book.returnedDate %></td>
                    <td>
                      <span class="status-returned">
                        <i class="bi bi-check-circle-fill me-1"></i> <%= book.status %>
                      </span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <!-- Section: Available Volumes in Stacks -->
      <div class="dashboard-card" id="available-stacks">
        <div class="dashboard-card-header">
          <h3 class="dashboard-card-title">
            <i class="bi bi-collection text-warning"></i> Available Volumes Ready in Stacks
          </h3>
          <span class="badge bg-light text-muted border font-monospace"><%= availableBooks.length %> Volumes</span>
        </div>

        <div class="dashboard-card-body">
          <% if (availableBooks.length === 0) { %>
            <p class="text-muted text-center py-3">No books currently available in repository stacks.</p>
          <% } else { %>
            <div class="row g-3">
              <% availableBooks.forEach(book => { %>
                <div class="col-md-6 col-lg-4 col-xl-3">
                  <div class="book-card-clean h-100">
                    <div class="book-thumb-wrap position-relative" style="height: 160px;">
                      <img
                        src="<%= getBookCover(book) %>"
                        alt="<%= book.title %> Cover"
                        loading="lazy"
                      />
                      <div class="position-absolute top-0 end-0 m-2">
                        <span class="badge bg-success bg-opacity-90 font-monospace small">
                          <%= book.copiesAvailable || book.quantity %> in Stacks
                        </span>
                      </div>
                    </div>
                    <div class="book-body p-3">
                      <div class="book-callno" style="font-size: 0.72rem;">
                        <i class="bi bi-geo-alt text-warning me-1"></i> <%= book.shelfLocation || 'STACK-A1' %>
                      </div>
                      <h4 class="book-title" style="font-size: 1.15rem; margin: 4px 0 2px;">
                        <%= book.title %>
                      </h4>
                      <p class="book-author small mb-2">
                        by <%= book.authorName || 'Cataloged Author' %>
                      </p>
                      <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                        <span class="font-monospace small text-muted">ISBN: <%= (book.isbn || '').substring(0, 10) %>...</span>
                        <button
                          type="button"
                          class="btn btn-sm btn-outline-dark py-0 px-2 small"
                          onclick="showBookDetails({
                            title: '<%= encodeURIComponent(book.title) %>',
                            author: '<%= encodeURIComponent(book.authorName || 'Cataloged Author') %>',
                            shelf: '<%= encodeURIComponent(book.shelfLocation || 'STACK-A1') %>',
                            isbn: '<%= encodeURIComponent(book.isbn || 'Not cataloged') %>',
                            copies: '<%= book.copiesAvailable || book.quantity %>',
                            cover: '<%= getBookCover(book) %>'
                          })"
                        >
                          <i class="bi bi-info-circle me-1"></i> Details
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Book Stack Details Modal (Keeps user on Dashboard) -->
    <div class="modal fade" id="stackBookModal" tabindex="-1" aria-labelledby="stackBookModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border: 1px solid var(--ath-border-warm); border-top: 4px solid var(--ath-terracotta); border-radius: 8px;">
          <div class="modal-header bg-light">
            <h5 class="modal-title" id="stackBookModalLabel" style="font-family: var(--font-serif); font-weight: 700; color: var(--ath-text-main);">
              <i class="bi bi-book me-2 text-warning"></i> Accession Details
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body p-4">
            <div class="row g-3 align-items-center mb-3">
              <div class="col-4 text-center">
                <img id="modalCover" src="" alt="Book Cover" class="img-fluid rounded shadow-sm border" style="max-height: 150px; object-fit: cover;" />
              </div>
              <div class="col-8">
                <h5 id="modalTitle" class="fw-bold mb-1 text-dark" style="font-family: var(--font-serif);"></h5>
                <p id="modalAuthor" class="text-muted small mb-2"></p>
                <div class="d-flex flex-wrap gap-1 mb-2">
                  <span id="modalShelf" class="badge bg-light text-dark border font-monospace small"></span>
                  <span id="modalCopies" class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 small"></span>
                </div>
                <div class="small text-muted font-monospace" id="modalIsbn"></div>
              </div>
            </div>

            <div class="p-3 bg-light rounded border small text-muted mb-3">
              <i class="bi bi-info-circle text-warning me-1"></i>
              <strong>Lending Rule:</strong> This volume is available in the physical stacks. Present your member ID (<code class="text-dark"><%= user._id.toString().substring(18) %></code>) at the Central Lending Desk to complete checkout.
            </div>

            <div id="modalReserveNotice" class="alert alert-success py-2 small d-none">
