<%- include("../partials/code-header") %>

<!-- Breadcrumb Navigation -->
<div class="admin-topbar d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <div class="d-flex align-items-center gap-2 small">
    <a href="/api/dashboard" class="text-muted text-decoration-none">Dashboard</a>
    <span class="text-muted">/</span>
    <a href="/api/transactions" class="text-muted text-decoration-none">Circulation</a>
    <span class="text-muted">/</span>
    <span class="fw-bold text-dark" style="font-family: var(--font-cinzel);">Record Dossier</span>
  </div>
  <div class="d-flex gap-2">
    <a href="/api/transactions/edit/<%= transaction._id %>" class="btn-terracotta btn-sm d-inline-flex align-items-center gap-1">
      <i class="bi bi-pencil"></i> Edit Transaction
    </a>
    <a href="/api/transactions" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
      <i class="bi bi-arrow-left"></i> Ledger
    </a>
  </div>
</div>

<!-- Header -->
<div class="mb-4">
  <span class="text-uppercase fw-bold" style="font-family: var(--font-cinzel); color: var(--ath-terracotta); font-size: 0.76rem; letter-spacing: 1.5px;">
    CIRCULATION DOSSIER &bull; TRANSACTION RECORD
  </span>
  <h1 class="display-6 fw-bold mt-1 mb-1" style="font-family: var(--font-serif); color: var(--ath-text-main);">
    Loan Transaction Record
  </h1>
  <p class="text-muted small mb-0">
    Accession tracking for <strong><%= transaction.bookId ? transaction.bookId.title : 'Cataloged Volume' %></strong>.
  </p>
</div>

<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-7">
    <div class="dashboard-card">
      <div class="dashboard-card-header d-flex align-items-center justify-content-between">
        <h3 class="dashboard-card-title" style="font-size: 1.15rem;">
          <i class="bi bi-arrow-left-right text-warning"></i> Loan Ledger Entry
        </h3>
        <span class="badge bg-light text-muted border font-monospace small">ID: <%= transaction._id %></span>
      </div>

      <div class="dashboard-card-body p-4">
        <!-- Status Banner -->
        <div class="d-flex align-items-center justify-content-between p-3 rounded mb-4 <%= transaction.status === 'Issued' ? 'bg-warning bg-opacity-10 border border-warning border-opacity-25' : 'bg-success bg-opacity-10 border border-success border-opacity-25' %>">
          <div class="d-flex align-items-center gap-2">
            <i class="bi <%= transaction.status === 'Issued' ? 'bi-hourglass-split text-warning' : 'bi-check-circle-fill text-success' %> fs-4"></i>
            <div>
              <strong class="text-dark d-block">Circulation Status: <%= transaction.status %></strong>
              <small class="text-muted"><%= transaction.status === 'Issued' ? 'Volume is currently with scholar member.' : 'Volume has been returned and restocked in stacks.' %></small>
            </div>
          </div>
          <span class="badge <%= transaction.status === 'Issued' ? 'bg-warning text-dark' : 'bg-success' %> font-monospace">
            <%= transaction.status %>
          </span>
        </div>

        <div class="table-responsive mb-4">
          <table class="table table-borderless align-middle mb-0">
            <tbody>
              <tr class="border-bottom">
                <th style="width: 180px;" class="text-muted small text-uppercase font-monospace">Volume Title</th>
                <td class="fw-bold text-dark fs-5" style="font-family: var(--font-serif);">
                  <%= transaction.bookId ? transaction.bookId.title : 'Unknown Volume' %>
                </td>
              </tr>
              <tr class="border-bottom">
                <th class="text-muted small text-uppercase font-monospace">Borrower / Patron</th>
                <td class="text-dark">
                  <strong><%= transaction.userId ? transaction.userId.name : 'Unknown User' %></strong>
                  <small class="text-muted font-monospace d-block"><%= transaction.userId ? transaction.userId.email : '' %></small>
                </td>
              </tr>
              <tr class="border-bottom">
                <th class="text-muted small text-uppercase font-monospace">Issue Date</th>
                <td class="font-monospace text-dark"><%= transaction.issueDate.toISOString().substring(0,10) %></td>
              </tr>
              <tr class="border-bottom">
                <th class="text-muted small text-uppercase font-monospace">Due Date</th>
                <td class="font-monospace fw-bold <%= transaction.status === 'Issued' ? 'text-danger' : 'text-dark' %>">
                  <%= transaction.dueDate.toISOString().substring(0,10) %>
                </td>
              </tr>
              <tr>
                <th class="text-muted small text-uppercase font-monospace">Discharge Date</th>
                <td class="font-monospace <%= transaction.returnDate ? 'text-success' : 'text-muted fst-italic' %>">
                  <%= transaction.returnDate ? transaction.returnDate.toISOString().substring(0,10) : 'Pending Physical Return' %>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 pt-3 border-top">
          <div class="d-flex gap-2">
            <a href="/api/transactions/edit/<%= transaction._id %>" class="btn-terracotta d-inline-flex align-items-center gap-1">
              <i class="bi bi-pencil"></i> Edit Status
            </a>
            <a href="/api/transactions" class="btn btn-outline-secondary">
              Back to Ledger
            </a>
          </div>
          <button
            type="button"
            class="btn btn-outline-danger d-inline-flex align-items-center gap-1"
            onclick="confirmDelete('/api/transactions/delete/<%= transaction._id %>')"
          >
            <i class="bi bi-trash"></i> Delete Entry
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include("../partials/code-footer") %>
