<%- include("../partials/code-header") %>

<!-- Breadcrumb Navigation -->
<div class="admin-topbar d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <div class="d-flex align-items-center gap-2 small">
    <a href="/api/dashboard" class="text-muted text-decoration-none">Dashboard</a>
    <span class="text-muted">/</span>
    <span class="fw-bold text-dark" style="font-family: var(--font-cinzel);">Circulation Ledger</span>
  </div>
  <a href="/api/transactions/add" class="btn-terracotta btn-sm d-inline-flex align-items-center gap-1">
    <i class="bi bi-plus-circle"></i> Issue Book Loan
  </a>
</div>

<!-- Header -->
<div class="mb-4">
  <span class="text-uppercase fw-bold" style="font-family: var(--font-cinzel); color: var(--ath-terracotta); font-size: 0.76rem; letter-spacing: 1.5px;">
    CIRCULATION DESK &bull; ACTIVE LOANS &amp; RETURNS
  </span>
  <h1 class="display-6 fw-bold mt-1 mb-1" style="font-family: var(--font-serif); color: var(--ath-text-main);">
    Circulation Ledger &amp; Borrowing Transactions
  </h1>
  <p class="text-muted small mb-0">
    Audit book checkout history, track due dates, discharge returns, and manage patron loans.
  </p>
</div>

<!-- Transactions Table Card -->
<div class="dashboard-card">
  <div class="dashboard-card-header d-flex flex-wrap align-items-center justify-content-between gap-3">
    <h3 class="dashboard-card-title" style="font-size: 1.15rem;">
      <i class="bi bi-arrow-left-right text-warning"></i> Registered Circulation Log
    </h3>
    <div class="d-flex align-items-center gap-2">
      <span class="badge bg-light text-muted border font-monospace small"><%= transactions.length %> Records</span>
      <input
        type="text"
        id="txnSearchInput"
        class="form-control form-control-sm"
        placeholder="Filter by patron or book..."
        style="width: 240px; font-size: 0.82rem;"
        onkeyup="filterTxnTable()"
      />
    </div>
  </div>

  <div class="table-responsive">
    <table class="dashboard-table" id="txnRegistryTable">
      <thead>
        <tr>
          <th style="width: 50px;">#</th>
          <th>Cataloged Volume</th>
          <th>Borrower / Patron</th>
          <th>Issued Date</th>
          <th>Due Date</th>
          <th>Return Date</th>
          <th>Circulation Status</th>
          <th style="width: 140px; text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% transactions.forEach((txn, index) => { %>
          <tr>
            <td class="font-monospace text-muted small"><%= index + 1 %></td>
            <td>
              <strong class="d-block text-dark" style="font-family: var(--font-serif); font-size: 1.05rem;">
                <%= txn.bookId ? txn.bookId.title : 'Unknown Volume' %>
              </strong>
              <% if (txn.bookId && txn.bookId.shelfLocation) { %>
                <small class="text-muted font-monospace"><i class="bi bi-geo-alt me-1 text-warning"></i><%= txn.bookId.shelfLocation %></small>
              <% } %>
            </td>
            <td>
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person text-muted"></i>
                <div>
                  <strong class="text-dark d-block"><%= txn.userId ? txn.userId.name : 'Unknown User' %></strong>
                  <small class="text-muted font-monospace" style="font-size: 0.72rem;"><%= txn.userId ? txn.userId.email : '' %></small>
                </div>
              </div>
            </td>
            <td class="font-monospace small text-muted">
              <%= txn.issueDate.toISOString().substring(0,10) %>
            </td>
            <td>
              <span class="font-monospace small fw-bold <%= txn.status === 'Issued' ? 'text-danger' : 'text-muted' %>">
                <%= txn.dueDate.toISOString().substring(0,10) %>
              </span>
            </td>
            <td class="font-monospace small">
              <% if (txn.returnDate) { %>
                <span class="text-success"><%= txn.returnDate.toISOString().substring(0,10) %></span>
              <% } else { %>
                <span class="text-muted fst-italic">Pending Return</span>
              <% } %>
            </td>
            <td>
              <% if (txn.status === 'Issued') { %>
                <span class="status-loan">
                  <i class="bi bi-hourglass-split me-1"></i> Active Loan
                </span>
              <% } else { %>
                <span class="status-returned">
                  <i class="bi bi-check-circle-fill me-1"></i> Returned
                </span>
              <% } %>
            </td>
            <td style="text-align: right;">
              <div class="btn-group btn-group-sm">
                <a href="/api/transactions/<%= txn._id %>" class="btn btn-outline-dark py-1 px-2" title="View Transaction">
                  <i class="bi bi-eye"></i>
                </a>
                <a href="/api/transactions/edit/<%= txn._id %>" class="btn btn-outline-secondary py-1 px-2" title="Edit Transaction">
                  <i class="bi bi-pencil"></i>
                </a>
                <button
                  type="button"
                  class="btn btn-outline-danger py-1 px-2"
                  title="Delete Record"
                  onclick="confirmDelete('/api/transactions/delete/<%= txn._id %>')"
                >
                  <i class="bi bi-trash"></i>
                </button>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- Search filter script -->
<script>
  function filterTxnTable() {
    const q = document.getElementById('txnSearchInput').value.toLowerCase();
    const rows = document.querySelectorAll('#txnRegistryTable tbody tr');
    rows.forEach(r => {
      const text = r.textContent.toLowerCase();
      r.style.display = text.includes(q) ? '' : 'none';
    });
  }
</script>

<%- include("../partials/code-footer") %>
