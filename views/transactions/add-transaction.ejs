<%- include("../partials/code-header") %>

<!-- Breadcrumb Navigation -->
<div class="admin-topbar d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <div class="d-flex align-items-center gap-2 small">
    <a href="/api/dashboard" class="text-muted text-decoration-none">Dashboard</a>
    <span class="text-muted">/</span>
    <a href="/api/transactions" class="text-muted text-decoration-none">Circulation</a>
    <span class="text-muted">/</span>
    <span class="fw-bold text-dark" style="font-family: var(--font-cinzel);">Issue Volume</span>
  </div>
  <a href="/api/transactions" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
    <i class="bi bi-arrow-left"></i> Back to Ledger
  </a>
</div>

<!-- Header -->
<div class="mb-4">
  <span class="text-uppercase fw-bold" style="font-family: var(--font-cinzel); color: var(--ath-terracotta); font-size: 0.76rem; letter-spacing: 1.5px;">
    DESK CHECKOUT &bull; BORROWING TRANSACTION
  </span>
  <h1 class="display-6 fw-bold mt-1 mb-1" style="font-family: var(--font-serif); color: var(--ath-text-main);">
    Issue Volume to Member
  </h1>
  <p class="text-muted small mb-0">
    Assign a cataloged book to an enrolled scholar member and specify the required return due date.
  </p>
</div>

<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-7">
    <div class="dashboard-card">
      <div class="dashboard-card-header">
        <h3 class="dashboard-card-title" style="font-size: 1.15rem;">
          <i class="bi bi-arrow-left-right text-warning"></i> Loan Issuance Form
        </h3>
        <span class="badge bg-light text-muted border font-monospace small">Standard Loan: 14 Days</span>
      </div>

      <div class="dashboard-card-body p-4">
        <!-- Error Alerts -->
        <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
          <div class="alert alert-danger py-2 px-3 small border-0 bg-danger bg-opacity-10 text-danger border border-danger border-opacity-20 rounded-2 mb-4">
            <ul class="mb-0 ps-3">
              <% errors.forEach(error => { %>
                <li><%= error.msg %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <form class="styled-form" action="/api/transactions" method="POST">
          <div class="mb-3">
            <label for="userId" class="auth-label">
              <i class="bi bi-person me-1"></i> Scholar Patron / Member
            </label>
            <select name="userId" id="userId" class="auth-input" required>
              <option value="">-- Select Member --</option>
              <% users.forEach(user => { %>
                <option value="<%= user._id %>" <%= oldInput?.userId == user._id ? 'selected' : '' %>>
                  <%= user.name %> (<%= user.email %>)
                </option>
              <% }) %>
            </select>
          </div>

          <div class="mb-3">
            <label for="bookId" class="auth-label">
              <i class="bi bi-book me-1"></i> Cataloged Book Volume
            </label>
            <select name="bookId" id="bookId" class="auth-input" required>
              <option value="">-- Select Book from Stacks --</option>
              <% books.forEach(book => { %>
                <option value="<%= book._id %>" <%= oldInput?.bookId == book._id ? 'selected' : '' %>>
                  <%= book.title %> [<%= book.copiesAvailable %> copies available &bull; <%= book.shelfLocation || 'Shelf A1' %>]
                </option>
              <% }) %>
            </select>
          </div>

          <div class="mb-4">
            <label for="dueDate" class="auth-label">
              <i class="bi bi-calendar-event me-1"></i> Return Due Date
            </label>
            <input
              type="date"
              name="dueDate"
              id="dueDate"
              class="auth-input font-monospace"
              value="<%= oldInput?.dueDate || '' %>"
              required
            />
            <small class="text-muted mt-1 d-block">Standard academic lending window is 14 calendar days from today.</small>
          </div>

          <div class="d-flex flex-wrap gap-2 pt-3 border-top">
            <button type="submit" class="btn-terracotta d-inline-flex align-items-center gap-1">
              <i class="bi bi-check-circle me-1"></i> Confirm &amp; Issue Volume
            </button>
            <a href="/api/transactions" class="btn btn-outline-secondary">
              Cancel &amp; Return
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Helper script to default due date to 14 days if not set -->
<script>
  window.addEventListener('DOMContentLoaded', () => {
    const dueInput = document.getElementById('dueDate');
    if (!dueInput.value) {
      const d = new Date();
      d.setDate(d.getDate() + 14);
      dueInput.value = d.toISOString().split('T')[0];
    }
  });
</script>

<%- include("../partials/code-footer") %>
