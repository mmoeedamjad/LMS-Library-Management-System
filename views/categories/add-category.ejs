<%- include("../partials/code-header") %>

<!-- Breadcrumb Navigation -->
<div class="admin-topbar d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <div class="d-flex align-items-center gap-2 small">
    <a href="/api/dashboard" class="text-muted text-decoration-none">Dashboard</a>
    <span class="text-muted">/</span>
    <a href="/api/category" class="text-muted text-decoration-none">Categories</a>
    <span class="text-muted">/</span>
    <span class="fw-bold text-dark" style="font-family: var(--font-cinzel);">New Classification</span>
  </div>
  <a href="/api/category" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
    <i class="bi bi-arrow-left"></i> Back to Categories
  </a>
</div>

<!-- Header -->
<div class="mb-4">
  <span class="text-uppercase fw-bold" style="font-family: var(--font-cinzel); color: var(--ath-terracotta); font-size: 0.76rem; letter-spacing: 1.5px;">
    TAXONOMY CLASSIFICATION &bull; REPOSITORY DISCIPLINES
  </span>
  <h1 class="display-6 fw-bold mt-1 mb-1" style="font-family: var(--font-serif); color: var(--ath-text-main);">
    Create New Archival Category
  </h1>
  <p class="text-muted small mb-0">
    Define a new discipline, literary period, or scientific subject area to group cataloged volumes.
  </p>
</div>

<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-7">
    <div class="dashboard-card">
      <div class="dashboard-card-header">
        <h3 class="dashboard-card-title" style="font-size: 1.15rem;">
          <i class="bi bi-tag text-warning"></i> Category Definition
        </h3>
        <span class="badge bg-light text-muted border font-monospace small">New Record</span>
      </div>

      <div class="dashboard-card-body p-4">
        <!-- Error Alerts -->
        <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
          <div class="alert alert-danger py-2 px-3 small border-0 bg-danger bg-opacity-10 text-danger border border-danger border-opacity-20 rounded-2 mb-4">
            <ul class="mb-0 ps-3">
              <% errors.forEach(error => { %>
                <li><%= error.msg %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <form class="styled-form" action="/api/category" method="POST">
          <div class="mb-3">
            <label for="name" class="auth-label">
              <i class="bi bi-tag me-1"></i> Category Name
            </label>
            <input
              type="text"
              name="name"
              id="name"
              class="auth-input"
              placeholder="e.g. South Asian History &amp; Literature"
              value="<%= oldInput?.name || '' %>"
              required
            />
          </div>

          <div class="mb-4">
            <label for="description" class="auth-label">
              <i class="bi bi-text-paragraph me-1"></i> Curatorial Scope &amp; Description
            </label>
            <textarea
              name="description"
              id="description"
              class="auth-input"
              rows="4"
              placeholder="Describe the topics, eras, or disciplines cataloged under this category classification..."
            ><%= oldInput?.description || '' %></textarea>
          </div>

          <div class="d-flex flex-wrap gap-2 pt-3 border-top">
            <button type="submit" class="btn-terracotta d-inline-flex align-items-center gap-1">
              <i class="bi bi-check-circle me-1"></i> Save Category Record
            </button>
            <a href="/api/category" class="btn btn-outline-secondary">
              Cancel &amp; Return
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include("../partials/code-footer") %>
