<%- include("../partials/code-header") %>

<!-- Breadcrumb Navigation -->
<div class="admin-topbar d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <div class="d-flex align-items-center gap-2 small">
    <a href="/api/dashboard" class="text-muted text-decoration-none">Dashboard</a>
    <span class="text-muted">/</span>
    <span class="fw-bold text-dark" style="font-family: var(--font-cinzel);">Categories Taxonomy</span>
  </div>
  <a href="/api/category/add" class="btn-terracotta btn-sm d-inline-flex align-items-center gap-1">
    <i class="bi bi-plus-circle"></i> Create Category
  </a>
</div>

<!-- Header -->
<div class="mb-4">
  <span class="text-uppercase fw-bold" style="font-family: var(--font-cinzel); color: var(--ath-terracotta); font-size: 0.76rem; letter-spacing: 1.5px;">
    COLLECTIONS TAXONOMY &bull; ARCHIVAL FIELDS
  </span>
  <h1 class="display-6 fw-bold mt-1 mb-1" style="font-family: var(--font-serif); color: var(--ath-text-main);">
    Academic &amp; Literary Classifications
  </h1>
  <p class="text-muted small mb-0">
    Organize the repository into distinct academic disciplines, literature genres, and research classifications.
  </p>
</div>

<!-- Category Taxonomy Table Card -->
<div class="dashboard-card">
  <div class="dashboard-card-header d-flex flex-wrap align-items-center justify-content-between gap-3">
    <h3 class="dashboard-card-title" style="font-size: 1.15rem;">
      <i class="bi bi-tags text-warning"></i> Active Collection Categories
    </h3>
    <span class="badge bg-light text-muted border font-monospace small"><%= categories.length %> Classifications</span>
  </div>

  <div class="table-responsive">
    <table class="dashboard-table">
      <thead>
        <tr>
          <th style="width: 50px;">#</th>
          <th>Category Classification</th>
          <th>Curatorial Scope &amp; Description</th>
          <th style="width: 140px; text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% categories.forEach((cat, index) => { %>
          <tr>
            <td class="font-monospace text-muted small"><%= index + 1 %></td>
            <td>
              <div class="d-flex align-items-center gap-2">
                <div class="p-2 rounded bg-warning bg-opacity-10 text-warning">
                  <i class="bi bi-folder2-open"></i>
                </div>
                <div>
                  <strong class="d-block text-dark" style="font-family: var(--font-serif); font-size: 1.05rem;">
                    <%= cat.name %>
                  </strong>
                  <small class="font-monospace text-muted" style="font-size: 0.72rem;">ID: <%= cat._id %></small>
                </div>
              </div>
            </td>
            <td class="text-muted small" style="max-width: 400px; line-height: 1.6;">
              <%= cat.description || 'General collection branch encompassing standard treatises and monographs.' %>
            </td>
            <td style="text-align: right;">
              <div class="btn-group btn-group-sm">
                <a href="/api/category/<%= cat._id %>" class="btn btn-outline-dark py-1 px-2" title="View Category">
                  <i class="bi bi-eye"></i>
                </a>
                <a href="/api/category/edit/<%= cat._id %>" class="btn btn-outline-secondary py-1 px-2" title="Edit Category">
                  <i class="bi bi-pencil"></i>
                </a>
                <button
                  type="button"
                  class="btn btn-outline-danger py-1 px-2"
                  title="Delete Category"
                  onclick="confirmDelete('/api/category/delete/<%= cat._id %>')"
                >
                  <i class="bi bi-trash"></i>
                </button>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include("../partials/code-footer") %>
