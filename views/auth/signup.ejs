<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Apply for Member Card | Library Management System</title>
    <!-- Google Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400;1,600&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Courier+Prime:wght@400;700&display=swap" rel="stylesheet" />
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body class="auth-viewport">
    <div class="auth-split-frame">
      <!-- Left Visual Editorial Panel -->
      <div class="auth-visual-panel-signup">
        <div>
          <a href="/api/home" class="auth-visual-brand">
            <div class="brand-seal" style="width: 36px; height: 36px; font-size: 1rem;">
              <i class="bi bi-book-half"></i>
            </div>
            <div>
              <div style="font-family: var(--font-cinzel); font-size: 1.05rem; font-weight: 800; letter-spacing: 1.5px;">ATHENAEUM</div>
              <div style="font-family: var(--font-serif); font-style: italic; font-size: 0.76rem; color: var(--ath-gold-bright);">Central Library &bull; Lahore</div>
            </div>
          </a>

          <div class="auth-visual-quote">
            &ldquo;The only thing you absolutely have to know, is the location of the library.&rdquo;
          </div>
          <div class="small text-white-50 mb-4" style="font-family: var(--font-cinzel); font-size: 0.72rem; letter-spacing: 1px;">
            SCHOLAR PRIVILEGES &bull; ESTD. 1928
          </div>

          <div class="mt-3">
            <div class="auth-visual-perk">
              <i class="bi bi-check2-circle text-warning"></i>
              <span>3 Physical Volumes per Checkout</span>
            </div>
            <div class="auth-visual-perk">
              <i class="bi bi-check2-circle text-warning"></i>
              <span>14-Day Lending Period with Self-Renewal</span>
            </div>
            <div class="auth-visual-perk">
              <i class="bi bi-check2-circle text-warning"></i>
              <span>Full Access to Main Reading Hall &amp; Wi-Fi</span>
            </div>
          </div>
        </div>

        <div class="pt-3 border-top border-white border-opacity-25">
          <a href="/api/home" class="text-white-50 small text-decoration-none d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Return to Public Catalog
          </a>
        </div>
      </div>

      <!-- Right Interactive Form Panel -->
      <div class="auth-form-panel">
        <div class="mb-3">
          <span class="text-uppercase fw-bold" style="font-family: var(--font-cinzel); color: var(--ath-terracotta); font-size: 0.72rem; letter-spacing: 1.5px;">
            MEMBERSHIP ENROLLMENT
          </span>
          <h2 class="fw-bold mb-1" style="font-family: var(--font-serif); font-size: 1.65rem; color: var(--ath-text-main);">
            Apply for Library Card
          </h2>
          <p class="text-muted small mb-0">
            Create your member credentials to borrow volumes and reserve stacks.
          </p>
        </div>

        <!-- Flash / Validation Errors -->
        <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
          <div class="alert alert-danger py-1 px-3 small border-0 bg-danger bg-opacity-10 text-danger border border-danger border-opacity-20 rounded-2 mb-3">
            <ul class="mb-0 ps-3">
              <% errors.forEach(error => { %>
                <li><%= error.msg %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <!-- Sign Up Form -->
        <form class="styled-form" action="/api/auth/signup" method="POST">
          <div class="mb-2">
            <label for="name" class="auth-label">
              <i class="bi bi-person me-1"></i> Full Name
            </label>
            <input
              type="text"
              name="name"
              id="name"
              class="auth-input"
              placeholder="e.g. John Doe"
              value="<%= oldInput?.name || '' %>"
              required
              autocomplete="name"
            />
          </div>

          <div class="mb-2">
            <label for="email" class="auth-label">
              <i class="bi bi-envelope me-1"></i> Email Address
            </label>
            <input
              type="email"
              name="email"
              id="email"
              class="auth-input"
              placeholder="name@example.com"
              value="<%= oldInput?.email || '' %>"
              required
              autocomplete="email"
            />
          </div>

          <div class="row g-2 mb-3">
            <div class="col-6">
              <label for="password" class="auth-label">
                <i class="bi bi-lock me-1"></i> Password
              </label>
              <input
                type="password"
                name="password"
                id="password"
                class="auth-input"
                placeholder="Min. 6 chars"
                required
                autocomplete="new-password"
              />
            </div>
            <div class="col-6">
              <label for="confirmPassword" class="auth-label">
                <i class="bi bi-shield-check me-1"></i> Confirm
              </label>
              <input
                type="password"
                name="confirmPassword"
                id="confirmPassword"
                class="auth-input"
                placeholder="Repeat pass"
                required
                autocomplete="new-password"
              />
            </div>
          </div>

          <button type="submit" class="btn-terracotta w-100 py-2 justify-content-center">
            <i class="bi bi-person-plus me-1"></i> Register Member Card
          </button>

          <div class="text-center mt-3 pt-2 border-top">
            <span class="text-muted small">Already enrolled?</span>
            <a href="/api/auth/login" class="fw-bold text-decoration-none small ms-1" style="color: var(--ath-terracotta);">
              Sign in to Portal
            </a>
          </div>
        </form>
      </div>
    </div>
  </body>
</html>
